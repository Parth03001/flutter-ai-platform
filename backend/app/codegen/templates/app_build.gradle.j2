plugins {
    id "com.android.application"
    id "dev.flutter.flutter-gradle-plugin"
    id "org.jetbrains.kotlin.android"
}

def localProperties = new Properties()
def localPropertiesFile = rootProject.file('local.properties')
if (localPropertiesFile.exists()) {
    localPropertiesFile.withReader('UTF-8') { reader ->
        localProperties.load(reader)
    }
}

android {
    namespace "{{ package_name }}"
    compileSdk rootProject.ext.flutterCompileSdkVersion
    ndkVersion "27.0.12077973"

    defaultConfig {
        applicationId "{{ package_name }}"
        minSdk rootProject.ext.flutterMinSdkVersion
        targetSdk rootProject.ext.flutterTargetSdkVersion
        versionCode 1
        versionName "1.0"
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }

    kotlinOptions {
        jvmTarget = '17'
    }

    sourceSets {
        main.java.srcDirs += 'src/main/kotlin'
    }

    buildTypes {
        release {
            signingConfig signingConfigs.debug
        }
    }
}

// CRITICAL: Disable AAR metadata checks that force AGP 8.6.0 for camera dependencies
tasks.withType(com.android.build.gradle.internal.tasks.CheckAarMetadataTask).configureEach {
    enabled = false
}

flutter {
    source '../..'
}

dependencies {
    implementation "org.jetbrains.kotlin:kotlin-stdlib:1.9.20"

    // --- MANUAL PLUGIN DEPENDENCIES ---
    // Skip any plugin not found in the pub cache (see settings.gradle scan).
    [
        'camera_android',
        'camera_android_camerax',
        'permission_handler_android',
        'flutter_plugin_android_lifecycle',
        'tflite_flutter',
        'path_provider_android',
        'shared_preferences_android',
        'mobile_scanner',
        'sqlite3_flutter_libs',
        'zsdk',
        'jni',
        'jni_flutter'
    ].each { name ->
        def proj = rootProject.findProject(":$name")
        if (proj != null) implementation(proj)
    }
}
