import 'package:flutter/material.dart';
import 'package:zsdk/zsdk.dart';

/// A Bluetooth printer (bonded or discovered via zsdk).
class DiscoveredPrinter {
  final String name;
  final String address; // Bluetooth MAC address (e.g. C4:D3:6A:AC:F0:AE)

  const DiscoveredPrinter({
    required this.name,
    required this.address,
  });
}

class PrintService {
  static final PrintService instance = PrintService._();
  PrintService._();

  final _zsdk = ZSDK();

  // ── Bluetooth discovery ───────────────────────────────────────────────────

  /// Return already-paired (bonded) Bluetooth devices.
  Future<List<DiscoveredPrinter>> getBondedPrinters() async {
    try {
      final devices = await _zsdk.getBondedDevices();
      return devices
          .map((d) => DiscoveredPrinter(
                name: (d['name'] as String?)?.isNotEmpty == true
                    ? d['name']!
                    : (d['address'] ?? 'Unknown'),
                address: d['address'] ?? '',
              ))
          .where((p) => p.address.isNotEmpty)
          .toList();
    } catch (e) {
      debugPrint('[PrintService] getBondedDevices error: $e');
      return [];
    }
  }

  /// Actively scan for nearby Zebra Bluetooth printers (Android only).
  Future<List<DiscoveredPrinter>> discoverBluetoothPrinters() async {
    try {
      final devices = await _zsdk.discoverBluetoothPrinters();
      return devices
          .map((d) => DiscoveredPrinter(
                name: (d['name'] as String?)?.isNotEmpty == true
                    ? d['name']!
                    : 'Zebra Printer',
                address: d['address'] ?? '',
              ))
          .where((p) => p.address.isNotEmpty)
          .toList();
    } catch (e) {
      debugPrint('[PrintService] discoverBluetoothPrinters error: $e');
      return [];
    }
  }

  // ── ZPL label generation ──────────────────────────────────────────────────

  /// Returns true if [value] is a real detected part (not null/empty/"None").
  bool _hasValue(String? value) {
    if (value == null) return false;
    final v = value.trim().toLowerCase();
    return v.isNotEmpty && v != 'none' && v != 'null' && v != 'n/a';
  }

  /// Build a ZPL II label for the inspection report.
  /// Designed for Zebra ZT411 at 300 dpi, 4-inch wide labels.
  String _buildZpl({
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
  }) {
    // Clean up ISO timestamp → "2026-03-26 15:46:09"
    final cleanDate = timestamp
        .replaceFirst('T', ' ')
        .replaceAll(RegExp(r'\.\d+$'), '');

    // Dynamic height:
    //   header 88 + info+QR 210 + status 90 + tasks-header 65
    //   + per-task 62 (+ 44 if has detail) + footer 60
    int taskRows = 0;
    for (final t in tasks) {
      taskRows += 62 + 12; // row + divider
      if (_hasValue(t['detectedPart'] as String?)) taskRows += 44;
    }
    final labelHeight = 88 + 210 + 90 + 65 + taskRows + 60;

    final buf = StringBuffer();
    int y = 0;

    buf.writeln('^XA');
    buf.writeln('^PW1200');
    buf.writeln('^LL$labelHeight');

    // ── Inverted header bar ───────────────────────────────────────────────────
    buf.writeln('^FO0,$y^GB1200,88,88^FS');              // solid black rect
    buf.writeln('^FO50,18^A0N,56,40^FR^FDINSPECTION REPORT^FS'); // white text
    y = 98;

    // ── Info (left) + QR code (right) ─────────────────────────────────────────
    buf.writeln('^FO50,$y^A0N,42,30^FDVIN   : $vin^FS');
    y += 58;
    buf.writeln('^FO50,$y^A0N,42,30^FDMODEL : $modelCode^FS');
    y += 58;
    buf.writeln('^FO50,$y^A0N,36,25^FDDATE  : $cleanDate^FS');

    // QR code encoding VIN, placed top-right of info section
    buf.writeln('^FO890,98^BQN,2,5^FDMA,$vin^FS');

    y += 68;

    // ── Status banner ─────────────────────────────────────────────────────────
    buf.writeln('^FO0,$y^GB1200,5,5^FS');
    y += 12;
    if (overallSuccess) {
      buf.writeln('^FO50,$y^GB480,70,6^FS');                  // outlined box
      buf.writeln('^FO80,${y + 13}^A0N,46,34^FD  PASSED  ^FS');
    } else {
      buf.writeln('^FO50,$y^GB480,70,70^FS');                 // filled box
      buf.writeln('^FO80,${y + 13}^A0N,46,34^FR^FD  FAILED  ^FS'); // white text
    }
    y += 84;

    // ── Task results ──────────────────────────────────────────────────────────
    buf.writeln('^FO0,$y^GB1200,5,5^FS');
    y += 10;
    buf.writeln('^FO50,$y^A0N,30,22^FDTASK RESULTS^FS');
    y += 42;
    buf.writeln('^FO0,$y^GB1200,3,3^FS');
    y += 12;

    for (final task in tasks) {
      final success = task['success'] as bool? ?? false;
      final name = task['taskName'] as String? ?? 'Task';
      final result = success ? 'PASS' : 'FAIL';

      // Task name left-aligned, result right-aligned
      buf.writeln('^FO50,$y^A0N,40,28^FD$name^FS');
      buf.writeln('^FO1040,$y^A0N,40,28^FD$result^FS');
      y += 54;

      final part = task['detectedPart'] as String?;
      if (_hasValue(part)) {
        buf.writeln('^FO80,$y^A0N,32,23^FD> ${part!.trim()}^FS');
        y += 44;
      }

      buf.writeln('^FO50,$y^GB1100,2,2^FS'); // thin row divider
      y += 12;
    }

    y += 6;
    buf.writeln('^FO0,$y^GB1200,5,5^FS');
    y += 10;

    // ── Footer ────────────────────────────────────────────────────────────────
    buf.writeln('^CF0,32');
    buf.writeln('^FO60,$y^FDFlutter AI Inspection System^FS');

    buf.writeln('^XZ');
    return buf.toString();
  }

  // ── Print ─────────────────────────────────────────────────────────────────

  /// Send ZPL inspection report to [printer] over Bluetooth.
  Future<bool> printInspectionReport({
    required DiscoveredPrinter printer,
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
  }) async {
    try {
      final zpl = _buildZpl(
        vin: vin,
        modelCode: modelCode,
        timestamp: timestamp,
        overallSuccess: overallSuccess,
        tasks: tasks,
      );

      final result = await _zsdk.printZplDataOverBluetooth(
        data: zpl,
        macAddress: printer.address,
      );

      final response = PrinterResponse.fromMap(result);
      if (response.errorCode == ErrorCode.SUCCESS) {
        return true;
      }
      debugPrint('[PrintService] ZPL BT print failed: ${response.statusInfo?.cause}');
      return false;
    } catch (e) {
      debugPrint('[PrintService] ZPL BT print error: $e');
      return false;
    }
  }
}
