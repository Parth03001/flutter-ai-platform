import 'dart:async';
import 'dart:io';
import 'dart:typed_data';
import 'package:flutter/material.dart';
import 'package:bluetooth_print/bluetooth_print.dart';
import 'package:bluetooth_print/bluetooth_print_model.dart';
// bluetooth_print uses Map<String, dynamic> for config (not a Config class)
import 'package:esc_pos_utils_plus/esc_pos_utils_plus.dart';

enum PrintConnectionType { bluetooth, network }

class DiscoveredPrinter {
  final String name;
  final String address;
  final PrintConnectionType type;
  final int port;
  final BluetoothDevice? btDevice;

  const DiscoveredPrinter({
    required this.name,
    required this.address,
    required this.type,
    this.port = 9100,
    this.btDevice,
  });
}

class PrintService {
  static final PrintService instance = PrintService._();
  PrintService._();

  StreamSubscription? _scanSub;

  /// Start Bluetooth scan. Calls [onDeviceFound] per new device, [onDone] when finished.
  void startBluetoothScan({
    required void Function(DiscoveredPrinter) onDeviceFound,
    required void Function() onDone,
  }) {
    final seen = <String>{};
    _scanSub?.cancel();

    BluetoothPrint.instance.startScan(
      timeout: const Duration(seconds: 12),
    );

    _scanSub = BluetoothPrint.instance.scanResults.listen((devices) {
      for (final d in devices) {
        final addr = d.address ?? '';
        if (addr.isNotEmpty && !seen.contains(addr)) {
          seen.add(addr);
          onDeviceFound(DiscoveredPrinter(
            name: (d.name?.isNotEmpty == true ? d.name! : addr),
            address: addr,
            type: PrintConnectionType.bluetooth,
            btDevice: d,
          ));
        }
      }
    });

    Future.delayed(const Duration(seconds: 13), () {
      stopBluetoothScan();
      onDone();
    });
  }

  void stopBluetoothScan() {
    _scanSub?.cancel();
    _scanSub = null;
    try {
      BluetoothPrint.instance.stopScan();
    } catch (_) {}
  }

  /// Scan the local WiFi subnet for ESC/POS printers on port 9100.
  Future<List<DiscoveredPrinter>> scanNetwork({
    void Function(int current, int total)? onProgress,
  }) async {
    final found = <DiscoveredPrinter>[];
    String? subnet;

    try {
      final interfaces =
          await NetworkInterface.list(type: InternetAddressType.IPv4);
      for (final iface in interfaces) {
        for (final addr in iface.addresses) {
          if (!addr.isLinkLocal && !addr.isLoopback) {
            final parts = addr.address.split('.');
            if (parts.length == 4) {
              subnet = '${parts[0]}.${parts[1]}.${parts[2]}';
              break;
            }
          }
        }
        if (subnet != null) break;
      }
    } catch (_) {}

    if (subnet == null) return found;

    const batchSize = 25;
    const total = 254;
    final addresses = List.generate(total, (i) => '$subnet.${i + 1}');

    for (int i = 0; i < addresses.length; i += batchSize) {
      onProgress?.call(i, total);
      final batch =
          addresses.sublist(i, (i + batchSize).clamp(0, addresses.length));
      final results = await Future.wait(batch.map((ip) async {
        try {
          final socket = await Socket.connect(ip, 9100,
              timeout: const Duration(milliseconds: 350));
          await socket.close();
          return DiscoveredPrinter(
            name: 'Printer @ $ip',
            address: ip,
            type: PrintConnectionType.network,
          );
        } catch (_) {
          return null;
        }
      }));
      found.addAll(results.whereType<DiscoveredPrinter>());
    }

    onProgress?.call(total, total);
    return found;
  }

  // ── Bluetooth printing via bluetooth_print ────────────────────────────────

  Future<bool> _printBluetooth({
    required BluetoothDevice device,
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
  }) async {
    try {
      final connected = await BluetoothPrint.instance.connect(device);
      if (connected != true) return false;

      final config = <String, dynamic>{};
      final List<LineText> list = [];

      list.add(LineText(
        type: LineText.TYPE_TEXT,
        content: 'INSPECTION REPORT',
        weight: 1,
        align: LineText.ALIGN_CENTER,

        linefeed: 1,
      ));
      list.add(LineText(
        type: LineText.TYPE_TEXT,
        content: '--------------------------------',
        align: LineText.ALIGN_CENTER,
        linefeed: 1,
      ));
      list.add(LineText(
        type: LineText.TYPE_TEXT,
        content: 'VIN: $vin',
        weight: 1,
        align: LineText.ALIGN_LEFT,
        linefeed: 1,
      ));
      list.add(LineText(
        type: LineText.TYPE_TEXT,
        content: 'Model: $modelCode',
        align: LineText.ALIGN_LEFT,
        linefeed: 1,
      ));
      list.add(LineText(
        type: LineText.TYPE_TEXT,
        content: 'Date: $timestamp',
        align: LineText.ALIGN_LEFT,
        linefeed: 1,
      ));
      list.add(LineText(
        type: LineText.TYPE_TEXT,
        content: '--------------------------------',
        align: LineText.ALIGN_CENTER,
        linefeed: 1,
      ));
      list.add(LineText(
        type: LineText.TYPE_TEXT,
        content: overallSuccess ? '[ PASSED ]' : '[ FAILED ]',
        weight: 1,
        align: LineText.ALIGN_CENTER,

        linefeed: 1,
      ));
      list.add(LineText(
        type: LineText.TYPE_TEXT,
        content: '--------------------------------',
        align: LineText.ALIGN_CENTER,
        linefeed: 1,
      ));

      for (final task in tasks) {
        final success = task['success'] as bool? ?? false;
        final name = task['taskName'] as String? ?? 'Task';
        final status = success ? 'PASS' : 'FAIL';
        list.add(LineText(
          type: LineText.TYPE_TEXT,
          content: '$name: $status',
          weight: success ? 0 : 1,
          align: LineText.ALIGN_LEFT,
          linefeed: 1,
        ));
        final part = task['detectedPart'] as String?;
        if (part != null && part.isNotEmpty) {
          list.add(LineText(
            type: LineText.TYPE_TEXT,
            content: '  > $part',
            align: LineText.ALIGN_LEFT,
            linefeed: 1,
          ));
        }
      }

      list.add(LineText(
        type: LineText.TYPE_TEXT,
        content: '--------------------------------',
        align: LineText.ALIGN_CENTER,
        linefeed: 1,
      ));
      list.add(LineText(
        type: LineText.TYPE_TEXT,
        content: 'Flutter AI Inspection',
        align: LineText.ALIGN_CENTER,
        linefeed: 3,
      ));

      await BluetoothPrint.instance.printReceipt(config, list);
      await Future.delayed(const Duration(milliseconds: 500));
      await BluetoothPrint.instance.disconnect();
      return true;
    } catch (e) {
      debugPrint('[PrintService] BT print error: $e');
      try {
        await BluetoothPrint.instance.disconnect();
      } catch (_) {}
      return false;
    }
  }

  // ── Network printing via raw TCP socket + ESC/POS ─────────────────────────

  Future<bool> _printNetwork({
    required String ip,
    required int port,
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
  }) async {
    try {
      final profile = await CapabilityProfile.load();
      final gen = Generator(PaperSize.mm80, profile);
      List<int> bytes = [];

      bytes += gen.text(
        'INSPECTION REPORT',
        styles: const PosStyles(
          align: PosAlign.center,
          bold: true,
          height: PosTextSize.size2,
          width: PosTextSize.size2,
        ),
      );
      bytes += gen.feed(1);
      bytes += gen.hr();
      bytes += gen.text('VIN    : $vin', styles: const PosStyles(bold: true));
      bytes += gen.text('Model  : $modelCode');
      bytes += gen.text('Date   : $timestamp');
      bytes += gen.hr();
      bytes += gen.text(
        overallSuccess ? '  [ PASSED ]  ' : '  [ FAILED ]  ',
        styles: PosStyles(
          align: PosAlign.center,
          bold: true,
          reverse: !overallSuccess,
        ),
      );
      bytes += gen.hr();

      for (final task in tasks) {
        final success = task['success'] as bool? ?? false;
        final name = task['taskName'] as String? ?? 'Task';
        bytes += gen.row([
          PosColumn(text: name, width: 9),
          PosColumn(
            text: success ? 'PASS' : 'FAIL',
            width: 3,
            styles: const PosStyles(align: PosAlign.right, bold: true),
          ),
        ]);
        final part = task['detectedPart'] as String?;
        if (part != null && part.isNotEmpty) {
          bytes += gen.text(
            '  > $part',
            styles: const PosStyles(fontType: PosFontType.fontB),
          );
        }
      }

      bytes += gen.hr();
      bytes += gen.text(
        'Flutter AI Inspection System',
        styles: const PosStyles(
          align: PosAlign.center,
          fontType: PosFontType.fontB,
        ),
      );
      bytes += gen.feed(3);
      bytes += gen.cut();

      final socket =
          await Socket.connect(ip, port, timeout: const Duration(seconds: 5));
      socket.add(Uint8List.fromList(bytes));
      await socket.flush();
      await socket.close();
      return true;
    } catch (e) {
      debugPrint('[PrintService] Network print error: $e');
      return false;
    }
  }

  // ── Public entry point ────────────────────────────────────────────────────

  Future<bool> printInspectionReport({
    required DiscoveredPrinter printer,
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
  }) async {
    if (printer.type == PrintConnectionType.bluetooth &&
        printer.btDevice != null) {
      return _printBluetooth(
        device: printer.btDevice!,
        vin: vin,
        modelCode: modelCode,
        timestamp: timestamp,
        overallSuccess: overallSuccess,
        tasks: tasks,
      );
    }
    return _printNetwork(
      ip: printer.address,
      port: printer.port,
      vin: vin,
      modelCode: modelCode,
      timestamp: timestamp,
      overallSuccess: overallSuccess,
      tasks: tasks,
    );
  }
}
