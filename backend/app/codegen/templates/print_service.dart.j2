import 'dart:io';
import 'dart:convert';
import 'package:flutter/material.dart';

/// A printer discovered on the local network (TCP/IP, port 9100).
class DiscoveredPrinter {
  final String name;
  final String address;
  final int port;

  const DiscoveredPrinter({
    required this.name,
    required this.address,
    this.port = 9100,
  });
}

class PrintService {
  static final PrintService instance = PrintService._();
  PrintService._();

  // ── Network discovery ─────────────────────────────────────────────────────

  /// Scan the local WiFi subnet for printers listening on port 9100 (ZPL/raw).
  Future<List<DiscoveredPrinter>> scanNetwork({
    void Function(int current, int total)? onProgress,
  }) async {
    final found = <DiscoveredPrinter>[];
    String? subnet;

    try {
      final interfaces =
          await NetworkInterface.list(type: InternetAddressType.IPv4);
      for (final iface in interfaces) {
        for (final addr in iface.addresses) {
          if (!addr.isLinkLocal && !addr.isLoopback) {
            final parts = addr.address.split('.');
            if (parts.length == 4) {
              subnet = '${parts[0]}.${parts[1]}.${parts[2]}';
              break;
            }
          }
        }
        if (subnet != null) break;
      }
    } catch (_) {}

    if (subnet == null) return found;

    const batchSize = 25;
    const total = 254;
    final addresses = List.generate(total, (i) => '$subnet.${i + 1}');

    for (int i = 0; i < addresses.length; i += batchSize) {
      onProgress?.call(i, total);
      final batch =
          addresses.sublist(i, (i + batchSize).clamp(0, addresses.length));
      final results = await Future.wait(batch.map((ip) async {
        try {
          final socket = await Socket.connect(ip, 9100,
              timeout: const Duration(milliseconds: 350));
          await socket.close();
          return DiscoveredPrinter(name: 'Printer @ $ip', address: ip);
        } catch (_) {
          return null;
        }
      }));
      found.addAll(results.whereType<DiscoveredPrinter>());
    }

    onProgress?.call(total, total);
    return found;
  }

  // ── ZPL label generation ──────────────────────────────────────────────────

  /// Build a ZPL II label for the inspection report.
  ///
  /// Designed for Zebra ZT411 at 300 dpi, 4-inch wide labels.
  /// Sends plain text over TCP port 9100 — no third-party package needed.
  String _buildZpl({
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
  }) {
    final buf = StringBuffer();
    int y = 30;

    // 300 dpi: 4 in wide = 1200 dots
    // Dynamic label height: header ~430 + 77 per task + footer 100
    final labelHeight = 430 + (tasks.length * 77) + 100;

    buf.writeln('^XA');
    buf.writeln('^PW1200');          // Print width: 1200 dots (4 in @ 300 dpi)
    buf.writeln('^LL$labelHeight'); // Label length in dots

    // ── Title ────────────────────────────────────────────────────────────────
    buf.writeln('^CF0,65');
    buf.writeln('^FO60,$y^FDINSPECTION REPORT^FS');
    y += 90;

    buf.writeln('^FO60,$y^GB1060,4,4^FS');
    y += 20;

    // ── Info fields ───────────────────────────────────────────────────────────
    buf.writeln('^CF0,40');
    buf.writeln('^FO60,$y^FDVIN   : $vin^FS');
    y += 56;
    buf.writeln('^FO60,$y^FDMODEL : $modelCode^FS');
    y += 56;
    buf.writeln('^FO60,$y^FDDATE  : $timestamp^FS');
    y += 65;

    buf.writeln('^FO60,$y^GB1060,4,4^FS');
    y += 20;

    // ── Overall status ────────────────────────────────────────────────────────
    buf.writeln('^CF0,60');
    final statusText = overallSuccess ? '  [ PASSED ]' : '  [ FAILED ]';
    if (!overallSuccess) {
      buf.writeln('^FO60,$y^FR^FD$statusText^FS'); // Reverse video for FAILED
    } else {
      buf.writeln('^FO60,$y^FD$statusText^FS');
    }
    y += 85;

    buf.writeln('^FO60,$y^GB1060,4,4^FS');
    y += 20;

    // ── Task results ──────────────────────────────────────────────────────────
    buf.writeln('^CF0,38');
    for (final task in tasks) {
      final success = task['success'] as bool? ?? false;
      final name = (task['taskName'] as String? ?? 'Task');
      final result = success ? 'PASS' : 'FAIL';

      buf.writeln('^FO60,$y^FD$name : $result^FS');
      y += 53;

      final part = task['detectedPart'] as String?;
      if (part != null && part.isNotEmpty) {
        buf.writeln('^CF0,32');
        buf.writeln('^FO80,$y^FD> $part^FS');
        buf.writeln('^CF0,38');
        y += 44;
      }
    }

    y += 12;
    buf.writeln('^FO60,$y^GB1060,4,4^FS');
    y += 18;

    // ── Footer ────────────────────────────────────────────────────────────────
    buf.writeln('^CF0,32');
    buf.writeln('^FO60,$y^FDFlutter AI Inspection System^FS');

    buf.writeln('^XZ');
    return buf.toString();
  }

  // ── Print ─────────────────────────────────────────────────────────────────

  /// Connect to [printer] via TCP, send ZPL label, then disconnect.
  Future<bool> printInspectionReport({
    required DiscoveredPrinter printer,
    required String vin,
    required String modelCode,
    required String timestamp,
    required bool overallSuccess,
    required List<Map<String, dynamic>> tasks,
  }) async {
    try {
      final zpl = _buildZpl(
        vin: vin,
        modelCode: modelCode,
        timestamp: timestamp,
        overallSuccess: overallSuccess,
        tasks: tasks,
      );

      final socket = await Socket.connect(
        printer.address,
        printer.port,
        timeout: const Duration(seconds: 5),
      );
      socket.add(utf8.encode(zpl));
      await socket.flush();
      await socket.close();
      return true;
    } catch (e) {
      debugPrint('[PrintService] ZPL print error: $e');
      return false;
    }
  }
}
