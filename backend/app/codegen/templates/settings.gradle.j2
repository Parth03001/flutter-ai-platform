pluginManagement {
    def flutterSdkPath = {
        def properties = new Properties()
        def localPropertiesFile = file("local.properties")
        if (localPropertiesFile.exists()) {
            localPropertiesFile.withInputStream { properties.load(it) }
        }
        def flutterSdkPath = properties.getProperty("flutter.sdk")
        if (flutterSdkPath == null) {
            flutterSdkPath = System.getenv("FLUTTER_ROOT") ?: System.getenv("FLUTTER_HOME")
        }
        return flutterSdkPath
    }()

    includeBuild("$flutterSdkPath/packages/flutter_tools/gradle")

    repositories {
        google()
        mavenCentral()
        gradlePluginPortal()
    }
}

plugins {
    id "dev.flutter.flutter-gradle-plugin" version "1.0.0" apply false
    id "com.android.application" version "8.1.1" apply false
    id "org.jetbrains.kotlin.android" version "1.9.20" apply false
}

include ":app"

// --- MANUAL OFFLINE PLUGIN BRIDGING ---
// Dynamically discovers the actual downloaded version in the pub cache so
// hardcoded version strings never cause a path mismatch after pub upgrades.
def pubCacheBase = new File("C:/pub-cache/hosted/pub.dev")

// Returns the android/ dir for the latest matching version in the pub cache,
// or null if the package was not downloaded (skipped silently).
def findPluginAndroidDir = { String pluginName ->
    if (!pubCacheBase.exists()) return null
    def candidates = pubCacheBase.listFiles()?.findAll { f ->
        f.isDirectory() && f.name.startsWith(pluginName + "-")
    }
    if (!candidates) return null
    def best = candidates.sort { a, b -> b.name <=> a.name }.first()
    def androidDir = new File(best, "android")
    return androidDir.exists() ? androidDir : null
}

def pluginNames = [
    "camera_android",
    "camera_android_camerax",
    "permission_handler_android",
    "flutter_plugin_android_lifecycle",
    "tflite_flutter",
    "path_provider_android",
    "shared_preferences_android",
    "mobile_scanner",
    "sqlite3_flutter_libs",
    "zsdk",
    "jni",
    "jni_flutter"
]

pluginNames.each { name ->
    def androidDir = findPluginAndroidDir(name)
    if (androidDir) {
        include ":$name"
        project(":$name").projectDir = androidDir
    }
}
