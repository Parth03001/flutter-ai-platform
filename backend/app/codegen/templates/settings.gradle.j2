pluginManagement {
    def flutterSdkPath = {
        def properties = new Properties()
        def localPropertiesFile = file("local.properties")
        if (localPropertiesFile.exists()) {
            localPropertiesFile.withInputStream { properties.load(it) }
        }
        def flutterSdkPath = properties.getProperty("flutter.sdk")
        if (flutterSdkPath == null) {
            flutterSdkPath = System.getenv("FLUTTER_ROOT") ?: System.getenv("FLUTTER_HOME")
        }
        return flutterSdkPath
    }()

    includeBuild("$flutterSdkPath/packages/flutter_tools/gradle")

    repositories {
        google()
        mavenCentral()
        gradlePluginPortal()
    }
}

plugins {
    id "dev.flutter.flutter-gradle-plugin" version "1.0.0" apply false
    id "com.android.application" version "8.1.1" apply false
    id "org.jetbrains.kotlin.android" version "1.9.20" apply false
}

include ":app"

// --- OFFLINE PLUGIN BRIDGING via .flutter-plugins-dependencies ---
// Flutter writes this JSON file during 'flutter pub get' with the exact
// versioned path for every plugin. Reading it here is more reliable than
// scanning the pub cache manually — no version strings to maintain.
def pluginsDepsFile = new File(settingsDir, "../.flutter-plugins-dependencies")
if (pluginsDepsFile.exists()) {
    def json = new groovy.json.JsonSlurper().parse(pluginsDepsFile)
    json?.plugins?.android?.each { plugin ->
        def androidDir = new File(plugin.path.toString(), "android")
        if (androidDir.exists()) {
            include ":${plugin.name}"
            project(":${plugin.name}").projectDir = androidDir
        }
    }
}
